&CONTROL
  calculation = 'bands'
  prefix      = 'aln'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
  verbosity   = 'high'
/

&SYSTEM
  ibrav       = 4
  celldm(1)   = 5.8832
  celldm(3)   = 1.6004
  nat         = 4
  ntyp        = 2
  ecutwfc     = 40
  ecutrho     = 320
  nbnd        = 30
  occupations = 'smearing'
  smearing    = 'gaussian'
  degauss     = 0.01
/

&ELECTRONS
  conv_thr    = 1.0d-9
  mixing_beta = 0.7
/

ATOMIC_SPECIES
  Al  26.98  Al.pbesol-n-kjpaw_psl.1.0.0.UPF
  N   14.01  N.pbesol-theos.UPF

ATOMIC_POSITIONS crystal
  Al  0.3333333330  0.6666666670  0.0000142905
  Al  0.6666666670  0.3333333330  0.5000142905
  N   0.3333333330  0.6666666670  0.3819857095
  N   0.6666666670  0.3333333330  0.8819857095

K_POINTS tpiba_b
  8
  0.000000  0.000000  0.000000  20   ! Gamma
  0.500000  0.000000  0.000000  20   ! M
  0.333333  0.333333  0.000000  20   ! K
  0.000000  0.000000  0.000000  20   ! Gamma
  0.000000  0.000000  0.500000  20   ! A
  0.500000  0.000000  0.500000  20   ! L
  0.333333  0.333333  0.500000  20   ! H
  0.000000  0.000000  0.500000  0    ! A

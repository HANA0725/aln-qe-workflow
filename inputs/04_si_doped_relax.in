&CONTROL
  calculation = 'relax'
  prefix      = 'aln_si'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
  verbosity   = 'high'
  etot_conv_thr = 1.0d-5
  forc_conv_thr = 1.0d-4
/

&SYSTEM
  ibrav       = 4
  celldm(1)   = 11.7664
  celldm(3)   = 1.6004
  nat         = 32
  ntyp        = 3
  ecutwfc     = 40
  ecutrho     = 320
  occupations = 'smearing'
  smearing    = 'gaussian'
  degauss     = 0.01
/

&ELECTRONS
  conv_thr    = 1.0d-8
  mixing_beta = 0.7
/

&IONS
  ion_dynamics = 'bfgs'
/

